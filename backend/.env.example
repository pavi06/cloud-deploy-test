# Copy to .env and fill in your Azure OpenAI details for local development.
# No Anthropic key, no AWS — the model is a GPT model hosted on Azure OpenAI.

# Your Azure OpenAI endpoint, e.g. https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Your Azure OpenAI API key.
AZURE_OPENAI_API_KEY=your-azure-openai-key

# The model = the deployment name you gave the GPT model in Azure OpenAI.
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Optional:
# AZURE_OPENAI_API_VERSION=2024-10-21
# OPENAI_MAX_TOKENS=4000
# Reasoning models only (gpt-5, o-series), needs a recent API version:
# OPENAI_REASONING_EFFORT=low
